<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\icon-on.ico</ApplicationIcon>
    <AssemblyName>AllsioPush</AssemblyName>
    <RootNamespace>AllsioPush</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>2026.6.1</Version>
    <AssemblyVersion>2026.6.1.0</AssemblyVersion>
    <FileVersion>2026.6.1.0</FileVersion>
    <Company>Charleston Telecom Solutions</Company>
    <Product>Allsio Push</Product>
    <Copyright>Copyright © 2026 Charleston Telecom Solutions</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon-on-128.png">
      <LogicalName>icon-on-128.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icon-off-128.png">
      <LogicalName>icon-off-128.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PusherClient" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
