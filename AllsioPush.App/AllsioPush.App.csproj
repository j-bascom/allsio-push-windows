<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon-on.ico</ApplicationIcon>
    <AssemblyName>AllsioPush</AssemblyName>
    <RootNamespace>AllsioPush</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Version>2026.6.16</Version>
    <AssemblyVersion>2026.6.16.0</AssemblyVersion>
    <FileVersion>2026.6.16.0</FileVersion>
    <Company>Charleston Telecom Solutions</Company>
    <Product>Allsio Push</Product>
    <Copyright>Copyright © 2026 Charleston Telecom Solutions</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon-on-128.png">
      <LogicalName>icon-on-128.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icon-off-128.png">
      <LogicalName>icon-off-128.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\icon-on.ico" />
    <Content Include="Resources\icon-off.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="WinUIEx" Version="2.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AllsioPush.Core\AllsioPush.Core.csproj" />
  </ItemGroup>
</Project>
